<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voucher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- 1. SOLID GOLD OFFSET SHADOW -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_voucher_shadow" />

    <!-- 2. FRONT TICKET / VOUCHER CARD -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/widget_voucher_bg"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!-- Top Header Row -->
        <RelativeLayout
            android:id="@+id/widget_voucher_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <TextView
                android:id="@+id/widget_voucher_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="OT PAYROLL VOUCHER"
                android:textColor="#E0E0E0"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_voucher_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_voucher_badge_bg"
                android:fontFamily="monospace"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="[ 4 DAYS LEFT ]"
                android:textColor="#FFD700"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Divider Line (Perforation Feel) -->
        <ImageView
            android:id="@+id/widget_voucher_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/widget_voucher_header"
            android:layout_marginTop="6dp"
            android:background="#2E2E2E"
            android:contentDescription="@null" />

        <!-- Cutoff Period Subtitle -->
        <TextView
            android:id="@+id/widget_voucher_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_voucher_divider"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="PERIOD: OCT 01 — OCT 15"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Hero Pay Amount -->
        <TextView
            android:id="@+id/widget_voucher_pay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_voucher_period"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="₱0.00"
            android:textColor="#FFD700"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Bottom Row: Hours Rendered & Action Button -->
        <RelativeLayout
            android:id="@+id/widget_voucher_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_voucher_tag_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_voucher_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0.0 HRS"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="RENDERED"
                    android:textColor="#777777"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_voucher_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_voucher_btn_bg"
                android:letterSpacing="0.05"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="+ LOG OT"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </RelativeLayout>
</FrameLayout>

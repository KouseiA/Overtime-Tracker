<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- 1. SOLID BLACK OFFSET SHADOW LAYER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_shadow_bg" />

    <!-- 2. FRONT CARD LAYER (Neo-Brutalist White Card with 2.5dp Black Stroke) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_bg"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Top Header: CURRENT CUTOFF Badge -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/widget_badge_bg"
            android:letterSpacing="0.08"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="CURRENT CUTOFF"
            android:textColor="@color/widget_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Subtitle: Full Month Range & Days Left (e.g. OCTOBER 1 – 15 · 4 DAYS LEFT) -->
        <TextView
            android:id="@+id/widget_cutoff_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_badge"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="CUTOFF SUMMARY"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Hero Massive Payout Amount in Gold -->
        <TextView
            android:id="@+id/widget_total_pay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_cutoff_title"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="₱0.00"
            android:textColor="@color/widget_gold"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Bottom Info & Action Row -->
        <RelativeLayout
            android:id="@+id/widget_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <TextView
                android:id="@+id/widget_hours_rendered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/widget_action_btn"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0.0 Hours Rendered"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_action_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_btn_bg"
                android:letterSpacing="0.06"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="LOG OT +"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </RelativeLayout>
</FrameLayout>
